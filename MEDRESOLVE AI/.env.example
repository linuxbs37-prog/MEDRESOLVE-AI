# MEDRESOLVE AI - Environment Configuration
# Copy to .env and fill in your values

# ============================================================
# REQUIRED: Google Gemini API Key (free tier at aistudio.google.com)
# ============================================================
GOOGLE_API_KEY=your_google_api_key_here

# ============================================================
# OPTIONAL: LangSmith Observability (free tier at smith.langchain.com)
# ============================================================
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=medresolve-ai

# ============================================================
# DATA PATHS (auto-configured relative to project root)
# ============================================================
# MEDRESOLVE_DATA_DIR=./data/guidelines
# DRUG_KB_DIR=./data/drugs
# CHROMA_PERSIST_DIR=./data/chroma_db
# BM25_INDEX_DIR=./data/bm25_indexes
